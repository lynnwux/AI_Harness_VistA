# Copy to agent/.env (git-ignored) and fill in. Never commit real values.
# VADEMO VistA sandbox — Atelier REST + the Harness REST service (port 80)
VADEMO_URL=http://<vademo-host>
VADEMO_USER=<sandbox user>
VADEMO_PASSWORD=<sandbox password>
# iris-ai-hub — the local IRIS container the Phase 2 production is built into (Atelier REST on its web port)
IRIS_AI_HUB_URL=http://localhost:<web port>
IRIS_AI_HUB_USER=<IRIS user>
IRIS_AI_HUB_PASSWORD=<IRIS password>
# the interclaw skill's scripts folder (the production build pushes and compiles with its lib/iris.py)
INTERCLAW_SCRIPTS=<path to .claude/skills/interclaw/scripts>
# the new-equipment bulletin's mail server, as IRIS sees it; leave BULLETIN_SMTP_HOST empty to keep the bulletin dry-run
BULLETIN_SMTP_HOST=<SMTP host, e.g. mailpit for the local mail catcher>
BULLETIN_SMTP_PORT=<SMTP port, e.g. 1025>
BULLETIN_SMTP_FROM=<sender address>
BULLETIN_SMTP_USER=<SMTP login, if the server needs one>
BULLETIN_SMTP_PASSWORD=<SMTP password, if the server needs one>
# local mail catcher's web address — when set, the build checks that the bulletin arrived
MAILPIT_URL=http://localhost:8025
# AI layer (optional) — iris-ai-hub's view of VADEMO, when it differs from the dev machine's VADEMO_URL above.
# Leave it commented out to use VADEMO_URL.
# VADEMO_URL_FROM_IRIS=http://<vademo-host-as-seen-from-iris-ai-hub>
# AI layer (optional) — a read-only VADEMO login for the chatbot's tools. Set BOTH lines or neither: with
# VADEMO_READ_USER set, VADEMO_READ_PASSWORD is required; with it unset, the AI build uses VADEMO_USER/VADEMO_PASSWORD.
# VADEMO_READ_USER=<read-only user>
# VADEMO_READ_PASSWORD=<read-only password>
# Bedrock bearer token — used by the Decide chat, and REQUIRED for 🔨 Build AI (stored in IRIS for the chatbot).
# It may come from your environment instead of this file.
# AWS_BEARER_TOKEN_BEDROCK=<token>
